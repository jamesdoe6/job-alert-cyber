# ══════════════════════════════════════════════════
#  VEILLE EMPLOI CYBER — .env (copier en .env)
# ══════════════════════════════════════════════════

# ── Gemini (scoring uniquement, gratuit) ──────────
# aistudio.google.com/app/apikey → Create API Key
GEMINI_API_KEY=AIzaSy-VOTRE_CLE_ICI

# ── France Travail API (recherche offres FR) ──────
# 1. Aller sur : francetravail.io/data/api/offres-emploi
# 2. Créer un compte → "Mes candidatures API" → Nouvelle application
# 3. Souscrire à l'API "Offres d'emploi v2"
# 4. Récupérer client_id et client_secret
FT_CLIENT_ID=PAR_VOTRE_CLIENT_ID
FT_CLIENT_SECRET=VOTRE_CLIENT_SECRET

# ── Adzuna API (agrège Indeed, LinkedIn, Monster…) ─
# 1. Aller sur : developer.adzuna.com
# 2. Register → Create Application
# 3. Récupérer app_id et app_key (250 req/jour gratuit)
ADZUNA_APP_ID=VOTRE_APP_ID
ADZUNA_APP_KEY=VOTRE_APP_KEY

# ── Email de réception ────────────────────────────
EMAIL_TO=james.marville@tonmail.com

# ── Gmail (expéditeur) ────────────────────────────
# Mot de passe d'application requis (pas ton vrai mdp)
# myaccount.google.com → Sécurité → Mots de passe des applications
EMAIL_FROM=toncompte@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=toncompte@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
